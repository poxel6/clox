// This is a comment
// Lox doesn't support multiline comments yet.

// == TYPES == 
// This is a string in Lox.
// Lox only supports '"' for strings.
"Hello, World!";

// This is a number in Lox
// Lox uses double percision floating points for all numbers.
69;
420.0;
3.1415923565;

// Lox supports boolean as well
true;
false;

// And null/undefined is nil in Lox.
nil;

// == VARIABLES == 
// This is a variable in Lox
var myString = "hello world";
var myNumber = 69 + 420;

var nilVariable;
// is the same as:
// var nilVariable = nil;

var complexArithmatic = (1 + (2 + 3 * 4) / 2);

{
	var localVariable = "This is local";
	// var localVariable = "This is illegal"; // Gives a compile time error.
	print localVariable;
}

// `print` is a builtin statement;
print myNumber;
print myString;

// You can wrap print arguments in parenthesis.
print(complexArithmatic);

